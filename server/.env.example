# Copie ce fichier en .env pour travailler en local (node --env-file=.env). Sur Railway : onglet Variables.
NODE_ENV=production
DATABASE_URL=            # Railway : référence ${{Postgres.DATABASE_URL}}
BETTER_AUTH_SECRET=      # openssl rand -base64 32  (32 caractères minimum, secret)
BETTER_AUTH_URL=https://api.lab.nohaba.com
SITE_URL=https://lab.nohaba.com
COOKIE_DOMAIN=lab.nohaba.com
FREE_UNTIL=2026-12-31    # tout est ouvert jusqu'à cette date (incluse)

# Connexion Google / Facebook / X : une paire de clés par réseau (laisse vide pour désactiver)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Code SMS (Africa's Talking)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=            # nom d'expéditeur validé (ex. NOHOBA) ; vide = numéro par défaut
AT_SANDBOX=0

# Paiement Mobile Money (CinetPay). PAY_MODE : cinetpay | off  (mock : seulement hors production, pour tester)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
PAY_MODE=off
